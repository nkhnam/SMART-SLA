{
  "name": "sla-dex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" prisma.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test:unit": "node --import tsx --test test/unit/config-env.test.ts test/unit/agreement-hash.test.ts test/unit/agreement-party.test.ts test/unit/agreement-lifecycle.test.ts test/unit/wallet-link.test.ts test/unit/anchor-recovery.test.ts test/unit/agreement-anchoring.test.ts test/unit/monitoring-kpi.test.ts test/unit/monitoring-security.test.ts test/unit/monitoring-ssrf.test.ts test/unit/evidence-protocol.test.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "test:anchor-integration": "node --import tsx --test test/integration/anchor-recovery.integration.test.ts",
    "test:phase2c-acceptance": "node scripts/run-phase2c-acceptance.mjs",
    "test:monitoring-reliability": "node scripts/run-phase2c-acceptance.mjs --worker-reliability",
    "test:evidence-reliability": "node scripts/run-phase2c-acceptance.mjs --publisher-reliability",
    "test:monitoring-browser": "node scripts/run-phase2c-acceptance.mjs --browser-monitoring",
    "typecheck:anchor-integration": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --esModuleInterop --experimentalDecorators --emitDecoratorMetadata test/integration/anchor-recovery.integration.test.ts",
    "test:migration-upgrade": "node scripts/test-migration-upgrade.mjs",
    "verify:evidence": "node --import tsx scripts/verify-evidence.ts",
    "test": "npm run test:unit && npm run test:integration",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie": "1.0.2",
    "dotenv": "17.2.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.3",
    "@types/node": "26.0.0",
    "eslint": "9.39.0",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.1": true,
    "@scarf/scarf": false
  }
}
