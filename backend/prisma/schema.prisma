generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  CUSTOMER
  PROVIDER
  OTHER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgreementStatus {
  DRAFT
  AWAITING_COUNTERPARTY
  AWAITING_SIGNATURES
  ANCHOR_PENDING
  ANCHOR_CONFIRMED
  ANCHOR_FAILED
  REJECTED
  CANCELLED
}

enum SignatureCollectionStatus {
  NOT_STARTED
  PENDING
  PARTIAL
  COMPLETE
  INVALIDATED
}

enum AnchorTransactionStatus {
  NOT_QUEUED
  QUEUED
  SUBMISSION_UNCERTAIN
  SUBMITTED
  CONFIRMED
  FAILED
  REPLACED
  RECONCILIATION_REQUIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum AgreementPartyRole {
  BUYER
  SUPPLIER
}

enum AgreementSignatureParty {
  BUYER
  SUPPLIER
}

enum MonitoringSourceType {
  HTTP_PROBE
  SIGNED_WEBHOOK
}

enum MonitoringTrustCategory {
  OPERATOR_COLLECTED
  PROVIDER_REPORTED
  SYNTHETIC_TEST
}

enum MonitoringRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum MonitoringErrorCategory {
  TIMEOUT
  DNS
  CONNECTION
  TLS
  HTTP
  RESPONSE_TOO_LARGE
  INVALID_RESPONSE
}

enum ObservationValidity {
  VALID
  INVALID
  UNKNOWN
}

enum KpiState {
  HEALTHY
  DEGRADED
  BREACH_CANDIDATE
  UNKNOWN
  INSUFFICIENT_DATA
}

enum EvidenceAnchorStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  RECONCILIATION_REQUIRED
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @unique @db.VarChar(320)
  passwordHash       String                @db.VarChar(255)
  displayName        String                @db.VarChar(120)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  memberships        Membership[]
  sessions           Session[]
  agreements         Agreement[]           @relation("AgreementCreator")
  versions           AgreementVersion[]
  auditEvents        AuditEvent[]
  invitationsSent    AgreementInvitation[] @relation("InvitationSentBy")
  invitationsDecided AgreementInvitation[] @relation("InvitationDecidedBy")
  authorizedSigners  AuthorizedSigner[]
  signerChallenges   SignerChallenge[]
  monitoringSources  MonitoringSource[]
}

model Organization {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String                 @db.VarChar(160)
  organizationType    OrganizationType
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  memberships         Membership[]
  agreements          Agreement[]
  auditEvents         AuditEvent[]
  invitationsSent     AgreementInvitation[]  @relation("InvitationInviterOrganization")
  invitationsReceived AgreementInvitation[]  @relation("InvitationInvitedOrganization")
  participants        AgreementParticipant[]
  authorizedSigners   AuthorizedSigner[]
  signerChallenges    SignerChallenge[]
  buyerSnapshots      SigningSnapshot[]      @relation("SigningSnapshotBuyerOrganization")
  supplierSnapshots   SigningSnapshot[]      @relation("SigningSnapshotSupplierOrganization")
  monitoringSources   MonitoringSource[]
  monitoringObservations MonitoringObservation[]
  kpiEvaluations      KpiEvaluation[]
  breachCandidates    BreachCandidate[]
  evidenceBatches     EvidenceBatch[]

  @@index([createdAt])
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Agreement {
  id                  String                    @id @default(uuid()) @db.Uuid
  reference           String                    @unique @db.VarChar(32)
  ownerOrganizationId String                    @db.Uuid
  createdByUserId     String                    @db.Uuid
  status              AgreementStatus           @default(DRAFT)
  signatureStatus     SignatureCollectionStatus @default(NOT_STARTED)
  blockchainStatus    AnchorTransactionStatus   @default(NOT_QUEUED)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  ownerOrganization   Organization              @relation(fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  createdBy           User                      @relation("AgreementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions            AgreementVersion[]
  invitations         AgreementInvitation[]
  participants        AgreementParticipant[]
  signingSnapshots    SigningSnapshot[]

  @@index([ownerOrganizationId, status, updatedAt])
  @@index([ownerOrganizationId, createdAt])
}

model AgreementVersion {
  id                      String            @id @default(uuid()) @db.Uuid
  agreementId             String            @db.Uuid
  version                 Int
  actorUserId             String            @db.Uuid
  name                    String            @db.VarChar(160)
  serviceDescription      String            @db.VarChar(4000)
  counterpartyDisplayName String            @db.VarChar(160)
  uptimeTargetPercent     Decimal           @db.Decimal(5, 2)
  responseTimeTargetMs    Int
  measurementWindowHours  Int
  exclusions              String[]          @default([])
  notes                   String?           @db.VarChar(2000)
  createdAt               DateTime          @default(now())
  agreement               Agreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actor                   User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  snapshots               SigningSnapshot[]
  monitoringSources       MonitoringSource[]
  monitoringObservations  MonitoringObservation[]
  kpiEvaluations          KpiEvaluation[]
  breachCandidates        BreachCandidate[]
  evidenceBatches         EvidenceBatch[]

  @@unique([agreementId, version])
  @@index([agreementId, version(sort: Desc)])
  @@index([actorUserId, createdAt])
}

model AgreementInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  agreementId           String           @db.Uuid
  agreementVersion      Int
  inviterOrganizationId String           @db.Uuid
  invitedOrganizationId String           @db.Uuid
  invitedByUserId       String           @db.Uuid
  decidedByUserId       String?          @db.Uuid
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime         @default(now())
  agreement             Agreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  inviterOrganization   Organization     @relation("InvitationInviterOrganization", fields: [inviterOrganizationId], references: [id], onDelete: Restrict)
  invitedOrganization   Organization     @relation("InvitationInvitedOrganization", fields: [invitedOrganizationId], references: [id], onDelete: Restrict)
  invitedBy             User             @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  decidedBy             User?            @relation("InvitationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([agreementId, agreementVersion])
  @@index([invitedOrganizationId, status, expiresAt])
  @@index([inviterOrganizationId, createdAt])
}

model AgreementParticipant {
  id                 String             @id @default(uuid()) @db.Uuid
  agreementId        String             @db.Uuid
  agreementVersion   Int
  organizationId     String             @db.Uuid
  role               AgreementPartyRole
  authorizedSignerId String?            @db.Uuid
  acceptedAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())
  agreement          Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorizedSigner   AuthorizedSigner?  @relation(fields: [authorizedSignerId], references: [id], onDelete: Restrict)

  @@unique([agreementId, agreementVersion, organizationId])
  @@unique([agreementId, agreementVersion, role])
  @@index([organizationId, acceptedAt])
}

model AuthorizedSigner {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @db.Uuid
  userId               String                 @db.Uuid
  address              String                 @db.VarChar(42)
  verifiedAt           DateTime               @default(now())
  revokedAt            DateTime?
  createdAt            DateTime               @default(now())
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatures           AgreementSignature[]
  selectedParticipants AgreementParticipant[]
  buyerSnapshots       SigningSnapshot[]      @relation("SigningSnapshotBuyerSigner")
  supplierSnapshots    SigningSnapshot[]      @relation("SigningSnapshotSupplierSigner")

  @@unique([organizationId, address])
  @@index([organizationId, revokedAt])
}

model SignerChallenge {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  address        String       @db.VarChar(42)
  nonce          String       @unique @db.Char(64)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, expiresAt])
}

model SigningSnapshot {
  id                         String                    @id @default(uuid()) @db.Uuid
  agreementId                String                    @db.Uuid
  version                    Int
  buyerOrganizationId        String                    @db.Uuid
  supplierOrganizationId     String                    @db.Uuid
  buyerSigner                String                    @db.VarChar(42)
  supplierSigner             String                    @db.VarChar(42)
  buyerAuthorizedSignerId    String                    @db.Uuid
  supplierAuthorizedSignerId String                    @db.Uuid
  canonicalPayload           String                    @db.Text
  snapshotHash               String                    @db.Char(66)
  agreementKey               String                    @unique @db.Char(66)
  nonce                      BigInt                    @default(0)
  validUntil                 DateTime
  signatureStatus            SignatureCollectionStatus @default(PENDING)
  invalidatedAt              DateTime?
  createdAt                  DateTime                  @default(now())
  agreement                  Agreement                 @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  versionRecord              AgreementVersion          @relation(fields: [agreementId, version], references: [agreementId, version], onDelete: Restrict)
  buyerOrganization          Organization              @relation("SigningSnapshotBuyerOrganization", fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  supplierOrganization       Organization              @relation("SigningSnapshotSupplierOrganization", fields: [supplierOrganizationId], references: [id], onDelete: Restrict)
  buyerAuthorizedSigner      AuthorizedSigner          @relation("SigningSnapshotBuyerSigner", fields: [buyerAuthorizedSignerId], references: [id], onDelete: Restrict)
  supplierAuthorizedSigner   AuthorizedSigner          @relation("SigningSnapshotSupplierSigner", fields: [supplierAuthorizedSignerId], references: [id], onDelete: Restrict)
  signatures                 AgreementSignature[]
  anchorIntent               AnchorIntent?

  @@unique([agreementId, version])
  @@index([buyerOrganizationId, createdAt])
  @@index([supplierOrganizationId, createdAt])
}

model AgreementSignature {
  id                 String                  @id @default(uuid()) @db.Uuid
  snapshotId         String                  @db.Uuid
  party              AgreementSignatureParty
  authorizedSignerId String                  @db.Uuid
  signerAddress      String                  @db.VarChar(42)
  signature          String                  @db.VarChar(132)
  digest             String                  @db.Char(66)
  submittedAt        DateTime                @default(now())
  snapshot           SigningSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  authorizedSigner   AuthorizedSigner        @relation(fields: [authorizedSignerId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, party])
  @@index([authorizedSignerId, submittedAt])
}

model AnchorIntent {
  id              String                  @id @default(uuid()) @db.Uuid
  snapshotId      String                  @unique @db.Uuid
  idempotencyKey  String                  @unique @db.VarChar(64)
  status          AnchorTransactionStatus @default(QUEUED)
  attemptCount    Int                     @default(0)
  relayerNonce    BigInt?
  transactionChainId Int?
  relayerAddress  String?                 @db.VarChar(42)
  signedTransaction String?               @db.Text
  transactionHash String?                 @unique @db.VarChar(66)
  replacementHash String?                 @db.VarChar(66)
  lastError       String?                 @db.VarChar(2000)
  leaseOwner      String?                 @db.VarChar(120)
  leaseUntil      DateTime?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  snapshot        SigningSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([status, leaseUntil, createdAt])
  @@unique([transactionChainId, relayerAddress, relayerNonce])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String       @db.Uuid
  organizationId String       @db.Uuid
  resourceType   String       @db.VarChar(40)
  resourceId     String       @db.VarChar(64)
  action         String       @db.VarChar(80)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model MonitoringSource {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @db.Uuid
  agreementId            String                   @db.Uuid
  agreementVersion       Int
  createdByUserId        String                   @db.Uuid
  type                   MonitoringSourceType
  trustCategory          MonitoringTrustCategory
  name                   String                   @db.VarChar(120)
  endpointUrl            String?                  @db.VarChar(2048)
  encryptedWebhookSecret String?                  @db.Text
  intervalSeconds        Int
  retentionDays          Int                      @default(90)
  enabled                Boolean                  @default(true)
  nextRunAt              DateTime?
  leaseOwner             String?                  @db.VarChar(120)
  leaseUntil             DateTime?
  lastRunAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreementVersionRecord AgreementVersion         @relation(fields: [agreementId, agreementVersion], references: [agreementId, version], onDelete: Restrict)
  createdBy              User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  runs                   MonitoringRun[]
  observations           MonitoringObservation[]
  evaluations            KpiEvaluation[]

  @@unique([id, agreementId, agreementVersion, organizationId])
  @@index([organizationId, agreementId, agreementVersion, enabled])
  @@index([enabled, nextRunAt, leaseUntil])
}

model MonitoringRun {
  id            String                   @id @default(uuid()) @db.Uuid
  sourceId      String                   @db.Uuid
  scheduledFor  DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  status        MonitoringRunStatus     @default(RUNNING)
  errorCategory MonitoringErrorCategory?
  errorCode     String?                  @db.VarChar(80)
  createdAt     DateTime                 @default(now())
  source        MonitoringSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observation   MonitoringObservation?

  @@unique([sourceId, scheduledFor])
  @@index([status, createdAt])
}

model MonitoringObservation {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @db.Uuid
  agreementId            String                    @db.Uuid
  agreementVersion       Int
  sourceId               String                    @db.Uuid
  runId                  String?                   @unique @db.Uuid
  idempotencyKey         String                    @db.VarChar(128)
  webhookNonce           String?                   @db.VarChar(128)
  trustCategory          MonitoringTrustCategory
  observedAt             DateTime
  ingestedAt             DateTime                  @default(now())
  scheduledFor           DateTime
  method                 MonitoringSourceType
  httpStatus             Int?
  latencyMs              Int?
  reachable              Boolean?
  errorCategory          MonitoringErrorCategory?
  probeDurationMs        Int?
  collectionRegion       String?                   @db.VarChar(80)
  agentIdentity          String?                   @db.VarChar(120)
  validity               ObservationValidity       @default(VALID)
  validityReason         String?                   @db.VarChar(160)
  retentionUntil         DateTime
  provenance             Json                      @default("{}")
  rawMetadata            Json                      @default("{}")
  source                 MonitoringSource          @relation(fields: [sourceId, agreementId, agreementVersion, organizationId], references: [id, agreementId, agreementVersion, organizationId], onDelete: Restrict)
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreementVersionRecord AgreementVersion          @relation(fields: [agreementId, agreementVersion], references: [agreementId, version], onDelete: Restrict)
  run                    MonitoringRun?            @relation(fields: [runId], references: [id], onDelete: Restrict)
  evidenceRecords        EvidenceRecord[]

  @@unique([sourceId, idempotencyKey])
  @@unique([sourceId, webhookNonce])
  @@index([agreementId, agreementVersion, observedAt])
  @@index([organizationId, agreementId, observedAt])
}

model KpiEvaluation {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  agreementId            String            @db.Uuid
  agreementVersion       Int
  sourceId               String            @db.Uuid
  windowStart            DateTime
  windowEnd              DateTime
  algorithmVersion       String            @db.VarChar(40)
  latencyStatistic       String            @db.VarChar(16)
  expectedSamples        Int
  healthyObservations    Int
  failedObservations     Int
  unknownObservations    Int
  coveragePercent        Decimal           @db.Decimal(5, 2)
  uptimePercent          Decimal?          @db.Decimal(5, 2)
  meanLatencyMs          Decimal?          @db.Decimal(12, 2)
  state                  KpiState
  createdAt              DateTime          @default(now())
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreementVersionRecord AgreementVersion  @relation(fields: [agreementId, agreementVersion], references: [agreementId, version], onDelete: Restrict)
  source                 MonitoringSource  @relation(fields: [sourceId, agreementId, agreementVersion, organizationId], references: [id, agreementId, agreementVersion, organizationId], onDelete: Restrict)
  breachCandidate        BreachCandidate?

  @@unique([sourceId, windowStart, windowEnd, algorithmVersion])
  @@index([agreementId, agreementVersion, windowStart, windowEnd])
  @@index([organizationId, createdAt])
}

model BreachCandidate {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  agreementId            String            @db.Uuid
  agreementVersion       Int
  evaluationId           String            @unique @db.Uuid
  state                  KpiState
  summary                String            @db.VarChar(240)
  createdAt              DateTime          @default(now())
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreementVersionRecord AgreementVersion  @relation(fields: [agreementId, agreementVersion], references: [agreementId, version], onDelete: Restrict)
  evaluation             KpiEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@index([agreementId, agreementVersion, createdAt])
  @@index([organizationId, createdAt])
}

model EvidenceBatch {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @db.Uuid
  agreementId            String                 @db.Uuid
  agreementVersion       Int
  windowStart            DateTime
  windowEnd              DateTime
  schemaVersion          String                 @db.VarChar(48)
  algorithmVersion       String                 @db.VarChar(40)
  merkleRoot             String                 @db.Char(66)
  batchDigest            String                 @db.Char(66)
  observationCount       Int
  canonicalManifest      Json
  createdAt              DateTime               @default(now())
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agreementVersionRecord AgreementVersion       @relation(fields: [agreementId, agreementVersion], references: [agreementId, version], onDelete: Restrict)
  records                EvidenceRecord[]
  anchorIntent           EvidenceAnchorIntent?

  @@unique([agreementId, agreementVersion, windowStart, windowEnd])
  @@index([organizationId, agreementId, agreementVersion, createdAt])
}

model EvidenceRecord {
  id              String                 @id @default(uuid()) @db.Uuid
  batchId         String                 @db.Uuid
  observationId   String                 @db.Uuid
  leafIndex       Int
  leafDigest      String                 @db.Char(66)
  canonicalRecord Json
  inclusionProof  Json
  createdAt       DateTime               @default(now())
  batch           EvidenceBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observation     MonitoringObservation  @relation(fields: [observationId], references: [id], onDelete: Restrict)

  @@unique([batchId, leafIndex])
  @@unique([batchId, observationId])
  @@index([observationId])
}

model EvidenceAnchorIntent {
  id                 String               @id @default(uuid()) @db.Uuid
  batchId            String               @unique @db.Uuid
  anchorKey          String               @unique @db.Char(66)
  status             EvidenceAnchorStatus @default(PENDING)
  attemptCount       Int                  @default(0)
  transactionChainId Int?
  relayerAddress     String?              @db.VarChar(42)
  relayerNonce       BigInt?
  signedTransaction  String?              @db.Text
  transactionHash    String?              @unique @db.VarChar(66)
  lastError          String?              @db.VarChar(160)
  leaseOwner         String?              @db.VarChar(120)
  leaseUntil         DateTime?
  submittedAt        DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  batch              EvidenceBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([transactionChainId, relayerAddress, relayerNonce])
  @@index([status, leaseUntil, createdAt])
}
