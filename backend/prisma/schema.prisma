// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- BẢNG DỮ LIỆU CỐT LÕI (MODELS) ---

// 1. Tổ chức / Doanh nghiệp (Bên thuê dịch vụ)
model Organization {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  orgType   String   @default("BUYER") // BUYER | SUPPLIER
  createdAt DateTime @default(now())

  // Gói dịch vụ (tính theo doanh nghiệp)
  planCode      String?   // PILOT | PAYG | STARTER | ENTERPRISE
  planStartedAt DateTime?
  planExpiresAt DateTime? // null với Pay as you go
  pilotUsedAt   DateTime? // Pilot chỉ dùng 1 lần

  users         User[]
  contracts     SlaContract[]  @relation("ClientContracts")
  provider      Provider?
  notifications Notification[]
  payments      PaymentTransaction[]
}

// 2. Thành viên trong tổ chức (Phân quyền)
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  jobTitle         String? // Chức vụ (VD: Giám đốc điều hành)
  role             String    @default("OPERATIONS") // Đã đổi thành String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0) // Số lần sai mật khẩu liên tiếp
  lockedUntil      DateTime? // Khóa tạm đến thời điểm này
  organizationId   String

  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt    DateTime     @default(now())
}

// 3. Nhà cung cấp dịch vụ (Marketplace)
model Provider {
  id             String           @id @default(uuid())
  name           String           @unique
  serviceType    String
  reputation     Int              @default(100) // Điểm uy tín
  stakedAmount   Float            @default(0) // Ký quỹ SLAD
  isVerified     Boolean          @default(false)
  description    String? // Giới thiệu nhà cung cấp (Marketplace)
  website        String?
  organizationId String?          @unique // Tài khoản doanh nghiệp của nhà cung cấp
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  listings       ServiceListing[]
  createdAt      DateTime         @default(now())

  contracts SlaContract[] @relation("ProviderContracts")
}

// 4. Hợp đồng SLA
model SlaContract {
  id           String @id @default(uuid())
  contractCode String @unique // Mã HĐ, VD: SLA-1029
  contractName String? // Tên hợp đồng do hai bên đặt để quản lý, tìm kiếm (nhãn, không nằm trong hash)

  // Relations
  clientId   String
  client     Organization @relation("ClientContracts", fields: [clientId], references: [id])
  providerId String
  provider   Provider     @relation("ProviderContracts", fields: [providerId], references: [id])

  // Điều khoản KPI
  serviceName            String
  uptimeTarget           Float // VD: 99.99
  responseMaxMs          Int // Thời gian phản hồi tối đa (ms)
  penaltyRule            String // Mô tả luật phạt
  challengeWindowSeconds Int       @default(172800) // Thời hạn phản đối riêng (mặc định 48h)
  templateCode           String? // Template gốc (CLOUD_HOSTING, IT_SUPPORT...)
  hashVersion            Int       @default(1) // 2 = hash gồm cả điều khoản KPI
  additionalConditions   String[]  @default([]) // Điều kiện bổ sung hai bên tự thống nhất (không đo tự động, có trong hash từ hashVersion 3)
  terminationAlert       Json?     // Cảnh báo đủ điều kiện chấm dứt: Uptime < 95% trong 2 tháng liên tiếp
  contractValueVnd       Float?    // Giá trị hợp đồng (VNĐ/tháng), cơ sở quy % hoàn phí ra tiền (hash từ v4)
  effectiveFrom          DateTime? // Ngày hiệu lực (00:00 giờ VN)
  effectiveTo            DateTime? // Ngày hết hạn (hết 23:59:59 giờ VN)
  penaltyCap             Json?     // Trần phạt 8% tổng giá trị HĐ: { warnedLevels, percent, appliedVnd, reachedAt }
  termsVersion           Int       @default(1) // Phiên bản điều khoản (tăng mỗi lần sửa khi chờ ký)
  termsUpdatedAt         DateTime?
  termsUpdatedById       String?

  status String @default("ACTIVE") // Đã đổi thành String

  // Dấu vân tay Web3
  slaHash String? // keccak256 dữ liệu SLA (đối chiếu với on-chain)
  txHash  String? // Mã giao dịch trên Polygon Amoy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oracleConfigs OracleConfig[]
  eventLogs     SlaEventLog[]
  violations    ViolationCase[]
  kpis          SlaKpi[]
  signatures    ContractSignature[]
  tickets       Ticket[]
}

// 5. Cấu hình tích hợp Oracle
model OracleConfig {
  id         String      @id @default(uuid())
  contractId String
  contract   SlaContract @relation(fields: [contractId], references: [id])

  sourceType   String // Đã đổi thành String (DATADOG, CLOUDWATCH, CUSTOM_WEBHOOK)
  endpointUrl  String?
  apiKeySecret String? // Cần mã hóa trước khi lưu
  isActive     Boolean  @default(true)  // false = đã gỡ nguồn này
  paused       Boolean  @default(false) // tạm dừng giám sát (giữ cấu hình)
  lastProbedAt DateTime?               // lần đo gần nhất (chu kỳ đo theo gói)
  createdAt    DateTime @default(now())
}

// 6. Nhật ký sự kiện từ Oracle (Logs)
model SlaEventLog {
  id         String      @id @default(uuid())
  contractId String
  contract   SlaContract @relation(fields: [contractId], references: [id])

  kpiCode     String // VD: "UPTIME_CHECK", "LATENCY_SPIKE"
  metricValue Float? // Giá trị thực tế đo được (VD: 98.5%)
  isUp        Boolean? // HTTP_PROBE: dịch vụ sống/chết
  latencyMs   Int? // HTTP_PROBE: thời gian phản hồi (ms)
  isViolation Boolean  @default(false)
  description String?

  // Dấu vân tay sự kiện trên Polygon
  eventTxHash String?

  timestamp DateTime @default(now())
}

// 7. Vụ vi phạm SLA + Challenge Window (Automated but Contestable)
model ViolationCase {
  id         String      @id @default(uuid())
  contractId String
  contract   SlaContract @relation(fields: [contractId], references: [id])

  kpiCode     String // VD: "UPTIME"
  targetValue Float // KPI cam kết (VD: 99.9)
  actualValue Float // KPI đo được (VD: 98.7)
  creditBps   Int // Service credit đề xuất, basis point (500 = 5%)
  creditVndApplied Float? // Số tiền hoàn thực áp sau khi xét trần 8% (chỉ vụ đã chốt)

  evidenceHash      String   @unique // keccak256 bằng chứng, ghi lên contract
  status            String   @default("PENDING") // PENDING | CHALLENGED | SETTLED
  challengeDeadline DateTime // Hết hạn cửa sổ phản đối

  challengedBy       String? // "BUYER" | "SUPPLIER"
  challengedById     String? // Người dùng đã bấm phản đối
  challengeReason    String?
  resolution         String? // UPHOLD | DISMISS (admin xử lý phản đối)
  resolutionNote     String?
  resolvedById       String?
  resolvedAt         DateTime?
  deadlineNotifiedAt DateTime? // Đã nhắc sắp hết hạn phản đối

  // Dấu vết trên Polygon cho từng bước
  recordTxHash    String? // recordViolation
  challengeTxHash String? // challenge
  settleTxHash    String? // settle

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 8. KPI linh hoạt của từng hợp đồng (SLA Builder)
model SlaKpi {
  id         String      @id @default(uuid())
  contractId String
  contract   SlaContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  kpiCode       String // UPTIME | RESPONSE_TIME | FIRST_RESPONSE | RESOLUTION_TIME | INCIDENT_RESPONSE
  name          String
  unit          String // %, ms, phút, giờ
  comparator    String // GTE (càng cao càng tốt) | LTE (càng thấp càng tốt)
  target        Float // Ngưỡng cam kết
  dataSource    String // HTTP_CHECK | WEBHOOK | JIRA
  windowMinutes Int // Kỳ đo (mặc định 30 ngày)
  exclusions    Json   @default("[]") // Khung loại trừ hằng tuần
  creditTiers   Json // Các bậc service credit
  minPercent    Float? // KPI ticket: % ticket tối thiểu phải đạt ngưỡng

  createdAt DateTime @default(now())

  @@unique([contractId, kpiCode])
}

// 9. Thông báo trong web (Dify soạn nội dung + gửi email)
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  contractId     String?
  violationId    String?
  type           String // VIOLATION_OPENED | DEADLINE_SOON | CHALLENGED | SETTLED | RESOLVED
  title          String
  message        String
  aiGenerated    Boolean      @default(false) // true = do Dify soạn
  emailStatus    String? // SENT | FAILED | SKIPPED
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// 10. Chữ ký điện tử EIP-712 của 2 bên
model ContractSignature {
  id             String      @id @default(uuid())
  contractId     String
  contract       SlaContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  party          String // BUYER | SUPPLIER
  organizationId String

  declaredWallet String? // Ví người ký đã khai báo
  declaredById   String?
  declaredAt     DateTime?

  method        String? // EIP712 (OTP: làm sau)
  signature     String? // Chữ ký từ ví
  signerAddress String? // Địa chỉ khôi phục từ chữ ký
  typedData     Json? // Nội dung đã ký (để ai cũng kiểm chứng lại được)
  signedById    String?
  signedAt      DateTime?
  ip            String?
  userAgent     String?
  signerEmail   String? // Email người ký (OTP)
  otpHash       String? // Bản băm mã OTP (không lưu mã gốc)
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpSentAt     DateTime?
  otpUserId     String? // Người đã yêu cầu mã

  createdAt DateTime @default(now())

  @@unique([contractId, party])
}

// 11. Ticket + khung chat tích hợp sẵn
model Ticket {
  id              String          @id @default(uuid())
  contractId      String
  contract        SlaContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind            String // NEGOTIATION | SUPPORT
  source          String          @default("BUILT_IN") // BUILT_IN | WEBHOOK
  externalId      String? // Mã ticket bên ngoài (VD: SUP-12)
  title           String
  status          String          @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  createdById     String
  createdByParty  String
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        TicketMessage[]

  @@unique([contractId, externalId])
  @@index([contractId, kind])
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  authorParty String
  authorName  String
  body        String
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

// 12. Dịch vụ nhà cung cấp đăng lên Marketplace (phải được admin duyệt)
model ServiceListing {
  id                   String    @id @default(uuid())
  providerId           String
  provider             Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title                String
  category             String
  description          String
  website              String?
  priceNote            String?
  challengeWindowHours Float
  kpis                 Json // KPI cam kết (cùng định dạng SLA Builder)
  additionalConditions String[]  @default([]) // Điều kiện bổ sung gợi ý cho hợp đồng
  status               String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED
  rejectReason         String?
  createdById          String
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// 13. Giao dịch gói dịch vụ (demo, không thu tiền thật). idempotencyKey chống ghi trùng.
model PaymentTransaction {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  kind           String       // SUBSCRIPTION | PER_CONTRACT
  planCode       String
  amountVnd      Int
  status         String       @default("PAID")
  idempotencyKey String       @unique
  contractId     String?
  description    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}
