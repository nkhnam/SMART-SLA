NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sladex:local-dev-only@localhost:5432/sladex_dev?schema=public
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168
# Configure all four values only when the registry is deployed and the relayer key is securely available.
# BLOCKCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# BLOCKCHAIN_CHAIN_ID=43113
# BLOCKCHAIN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# BLOCKCHAIN_RELAYER_PRIVATE_KEY=<secure-local-64-hex-character-key>
BLOCKCHAIN_CONFIRMATIONS=1
# Optional local seed values; the seed command fails until these are supplied.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_DISPLAY_NAME=
SEED_ORGANIZATION_NAME=
SEED_ORGANIZATION_TYPE=CUSTOMER
